+        "volume_1h_usd": 200_000.0,
+        "volume_5m_usd": 35_000.0,
+        "buys_5m": 40,
+        "sells_5m": 10,
+        "buys_1h": 150,
+        "sells_1h": 80,
+        "price_change_5m_pct": 6.0,
+        "price_change_1h_pct": 18.0,
+        "age_seconds": 3600.0,
+    }
