+class _StubDecision:
+    def __init__(self, answers: dict[str, dict[str, Any]]):
+        self._answers = answers
+
+    async def decide(self, *, input_text: str, questions: dict[str, dict[str, Any]]) -> dict[str, dict[str, Any]]:
+        return self._answers
