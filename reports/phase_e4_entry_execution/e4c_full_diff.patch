+def _mk_unsigned_tx(kp: Keypair) -> str:
+    msg = MessageV0.try_compile(kp.pubkey(), [], [], Hash.default())
+    return base64.b64encode(bytes(VersionedTransaction(msg, [kp]))).decode("ascii")
