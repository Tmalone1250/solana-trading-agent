+        if allowed_enforced:
+            assert len(out["chart_positions"]) == 1
+        else:
+            assert out == {"pending_order": None}
+            assert get_inflight_buy_reservations(str(db.db_path)) == []
+            row = db.get_action_log(limit=1)[0]
+            assert row["pool_route_status"] == expected_status
