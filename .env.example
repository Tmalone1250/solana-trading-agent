# Solana Memecoin Trading Agent (solana-meme-agent) Configuration

# Execution mode: "paper" (default) or "live"
EXECUTION_MODE=paper

# Hunting lane:
#   momentum_runners -> $250K-$2M MC, pair age >= 1h
#   graduations      -> $50K-$150K MC
HUNTING_LANE=momentum_runners

# Allowed Chart entry strategies (comma-separated):
#   BREAKOUT_IGNITION, SWEEP_RECLAIM, DISPLACEMENT_RETEST, LEG2_ENTRY
# For BREAKOUT_IGNITION-only isolation, set CHART_ENABLED_STRATEGIES=BREAKOUT_IGNITION
CHART_ENABLED_STRATEGIES=BREAKOUT_IGNITION,SWEEP_RECLAIM,DISPLACEMENT_RETEST,LEG2_ENTRY

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
JUPITER_API_KEY=your_jupiter_api_key_here

# Required ONLY when EXECUTION_MODE=live (base58-encoded Solana secret key)
SOLANA_PRIVATE_KEY_BS58=

# Narrowed Risk Parameters & Dual-Lane 3+3 Concurrency
PAPER_STARTING_SOL=0.7
PAPER_TX_FEE_SOL=0.001
TRADE_SIZE_SOL=0.5
MAX_CHART_POSITIONS=3
MAX_WHALE_POSITIONS=3
MAX_OPEN_POSITIONS=6
HARD_STOP_LOSS_PCT=0.10
BREAKEVEN_ARM_PCT=0.08
BREAKEVEN_FLOOR_PCT=0.02
TRAIL_ARM_PCT=0.12
TRAIL_PULLBACK_PCT=0.06
PARTIAL_TP_TRIGGER_PCT=15.0
PARTIAL_TP_SELL_FRACTION=0.50
RUNNER_TRAIL_PULLBACK_PCT=10.0
REENTRY_CURL_PCT=0.05
MAX_REENTRY_CHASE_PCT=0.08
MAX_REENTRIES_PER_MINT=2
EXODUS_SELL_RATIO=0.65
EXODUS_LIQ_DROP_PCT=0.10
WATCH_TIMEOUT_MINUTES=20
DAILY_MAX_LOSS_PCT=0.20

# Scanner, Rotating Watchlist, Storage & Telemetry
MAX_WATCH_BATCH=5
MIN_WATCHLIST_SOAK_MINUTES=3
OHLCV_CACHE_SECONDS=90
OHLCV_PACING_DELAY_SECONDS=6.5
ANTI_CHASE_HIGH_BUFFER_PCT=0.05
BREAKOUT_MIN_VOL_RATIO=1.5
BREAKOUT_MAX_COIL_RANGE_PCT=10.0
BREAKOUT_MIN_SCORE=75
MIN_MC_USD=100000
MAX_MC_USD=3000000
MIN_AGE_MINUTES=30
MIN_VOL_1H_USD=30000
MIN_LIQUIDITY_USD=25000
MIN_BUY_CONFIDENCE=0.60
MIN_NARRATIVE_SCORE=2.5
MIN_MOMENTUM_SCORE=3.0
MAX_VAMP_ENTRY=0.55
COOLDOWN_HOURS=2
SAFETY_REJECT_COOLDOWN_MINUTES=60
VAMP_DROP_COOLDOWN_MINUTES=20
LOW_SCORE_COOLDOWN_MINUTES=15
STALE_WATCH_TIMEOUT_MINUTES=15
STALE_WATCH_COOLDOWN_MINUTES=10
VAMP_EVICT_THRESHOLD=0.85
VAMP_WARN_THRESHOLD=0.75
GECKOTERMINAL_CACHE_SECONDS=60
MONITOR_POLL_SECONDS=5
DUCKDB_PATH=solana_meme_agent.duckdb
TELEMETRY_HOST=0.0.0.0
TELEMETRY_PORT=8002
AGENT_LOCAL_URL=http://127.0.0.1:8002

# Jupiter Token API v2 Discovery & Organic Enrichment
ENABLE_JUPITER_DISCOVERY=true
JUPITER_POLL_CACHE_SECONDS=60
JUPITER_MIN_ORGANIC_SCORE=0.0

# X (TwitterAPI.io) Discovery & Sentiment (optional budgeted background worker)
ENABLE_X_DISCOVERY=false
TWITTERAPI_IO_KEY=
X_LIST_IDS=
X_SEARCH_QUERY="pump" (solana OR dexscreener) min_faves:5 -filter:retweets
X_POLL_INTERVAL_MINUTES=30
X_DAILY_TWEET_CAP=1000
X_SIGNAL_TTL_MINUTES=60

# Helius Enhanced Webhook Whale Tracking (Phase 2)
ENABLE_HELIUS_WHALE_WEBHOOK=false
HELIUS_API_KEY=
HELIUS_WEBHOOK_ID=
HELIUS_ROSTER_CACHE_SECONDS=300
HELIUS_AUTH_HEADER=
HELIUS_TRACKED_WALLETS=
WHALE_SIGNAL_TTL_MINUTES=30
WHALE_MIN_SOL_SPENT=0.5

# WHALE_SCALP Fast-Track Strategy (Slot 2: Multi-Whale Confluence up to $50M MCAP)
WHALE_STRATEGY_ENABLED=true
WHALE_POSITION_SOL=0.25
WHALE_MIN_SOLO_BUY_SOL=1.5
WHALE_MIN_UNIQUE_WALLETS=2
WHALE_MIN_CONFLUENCE_WALLETS=2
WHALE_ENTRY_MAX_AGE_SECONDS=60
WHALE_MIN_MCAP_USD=15000
WHALE_MAX_MCAP_USD=50000000
WHALE_MIN_LIQ_USD=40000
WHALE_MIN_LIQUIDITY_USD=40000
WHALE_TP_PCT=15.0
WHALE_PARTIAL_TP_TRIGGER_PCT=15.0
WHALE_PARTIAL_TP_SELL_FRACTION=0.50
WHALE_RUNNER_TRAIL_PULLBACK_PCT=10.0
WHALE_BREAKEVEN_ARM_PCT=5.0
WHALE_BREAKEVEN_FLOOR_PCT=1.0
WHALE_TRAIL_ARM_PCT=8.0
WHALE_TRAIL_DROP_PCT=3.5
WHALE_TIGHT_TRAIL_ARM_PCT=12.0
WHALE_TIGHT_TRAIL_DROP_PCT=2.5
WHALE_HARD_STOP_PCT=-10.0
WHALE_TIME_STOP_SECONDS=300
WHALE_TIME_STOP_MIN_PNL_PCT=4.0
WHALE_MONITOR_POLL_SECONDS=2.0
WHALE_MIN_BREAKOUT_SCORE=50
WHALE_BLOCK_EXTENDED=true
