[Unit]
Description=Solana Trading Agent - Daily Automated Whale Discovery & Helius Sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tmalone1250
WorkingDirectory=/home/tmalone1250/solana-trading-agent
ExecStart=/home/tmalone1250/solana-trading-agent/venv/bin/python scripts/auto_discover_whales.py --apply
StandardOutput=journal
StandardError=journal
TimeoutStartSec=300
